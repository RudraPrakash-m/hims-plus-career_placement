            "required": true,
            "message": "Student ID is required"
          }
        },
        {
          "name": "enrollmentDate",
          "label": "Enrollment Date",
          "type": "date",
          "gridColumn": 1,
          "validation": {
            "required": true,
            "message": "Enrollment date is required"
          }
        },
        {
          "name": "course",
          "label": "Course",
          "type": "select",
          "placeholder": "-- Select --",
          "gridColumn": 1,
          "options": [
            {
              "label": "B.Tech",
              "value": "BTech"
            },
            {
              "label": "B.Sc",
              "value": "BSc"
            },
            {
              "label": "B.A",
              "value": "BA"
            },
            {
              "label": "M.Tech",
              "value": "MTech"
            },
            {
              "label": "M.Sc",
              "value": "MSc"
            }
          ],
          "validation": {
            "required": true,
            "message": "Course is required"
          }
        },
        {
          "name": "semester",
          "label": "Semester",
          "type": "select",
          "placeholder": "-- Select --",
          "gridColumn": 1,
          "options": [
            {
              "label": "1st Semester",
              "value": "1"
            },
            {
              "label": "2nd Semester",
              "value": "2"
            },
            {
              "label": "3rd Semester",
              "value": "3"
            },
            {
              "label": "4th Semester",
              "value": "4"
            },
            {
              "label": "5th Semester",
              "value": "5"
            },
            {
              "label": "6th Semester",
              "value": "6"
            },
            {
              "label": "7th Semester",
              "value": "7"
            },
            {
              "label": "8th Semester",
              "value": "8"
            }
          ],
          "validation": {
