{
  "steps": [
    {
      "id": "personal",
      "label": "Personal Information",
      "fields": [
        {
          "name": "firstName",
          "label": "First Name",
          "type": "text",
          "gridColumn": 1,
          "validation": {
            "required": true,
            "minLength": 2,
            "message": "First name is required"
          }
        },
        {
          "name": "lastName",
          "label": "Last Name",
          "type": "text",
          "gridColumn": 1,
          "validation": {
            "required": true,
            "minLength": 2,
            "message": "Last name is required"
          }
        },
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "gridColumn": 1,
          "validation": {
            "required": true,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "message": "Enter valid email"
          }
        },
        {
          "name": "phone",
          "label": "Phone Number",
          "type": "tel",
          "gridColumn": 1,
          "maxLength": 10,
          "validation": {
            "required": true,
            "pattern": "^[0-9]{10}$",
            "message": "Enter valid 10 digit phone number"
          }
        },
        {
          "name": "dateOfBirth",
          "label": "Date of Birth",
          "type": "date",
          "gridColumn": 1,
          "validation": {
            "required": true,
            "message": "Date of birth is required"
          }
        },
        {
          "name": "gender",
          "label": "Gender",
          "type": "select",
          "placeholder": "-- Select --",
          "gridColumn": 1,
          "options": [
            {
              "label": "Male",
              "value": "Male"
            },
            {
              "label": "Female",
              "value": "Female"
            },
            {
              "label": "Other",
              "value": "Other"
            }
          ],
          "validation": {
            "required": true,
            "message": "Gender is required"
          }
        }
      ]
    },
    {
      "id": "academic",
      "label": "Academic Information",
      "fields": [
        {
          "name": "studentId",
