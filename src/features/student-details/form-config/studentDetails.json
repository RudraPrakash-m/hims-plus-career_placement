            {
              "label": "Electrical",
              "value": "EE"
            }
          ],
          "validation": {
            "required": true,
            "message": "Department is required"
          }
        }
      ]
    },
    {
      "id": "address",
      "label": "Address Information",
      "fields": [
        {
          "name": "street",
          "label": "Street Address",
          "type": "text",
          "gridColumn": 2,
          "validation": {
            "required": true,
            "message": "Street address is required"
          }
        },
        {
          "name": "city",
          "label": "City",
          "type": "text",
          "gridColumn": 1,
          "validation": {
            "required": true,
            "message": "City is required"
          }
        },
        {
          "name": "state",
          "label": "State",
          "type": "text",
          "gridColumn": 1,
          "validation": {
            "required": true,
            "message": "State is required"
          }
        },
        {
          "name": "zipCode",
          "label": "Zip Code",
          "type": "text",
          "gridColumn": 1,
          "validation": {
            "required": true,
            "message": "Zip code is required"
          }
        },
        {
          "name": "country",
          "label": "Country",
          "type": "text",
          "gridColumn": 1,
          "validation": {
