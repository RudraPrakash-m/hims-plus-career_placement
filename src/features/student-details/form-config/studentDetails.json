        },
        {
          "name": "gpa",
          "label": "GPA",
          "type": "number",
          "gridColumn": 1,
          "validation": {
            "required": true,
            "message": "GPA is required"
          }
        },
        {
          "name": "department",
          "label": "Department",
          "type": "select",
          "placeholder": "-- Select --",
          "gridColumn": 1,
          "options": [
            {
              "label": "Computer Science",
              "value": "CS"
            },
            {
              "label": "Electronics",
              "value": "EC"
            },
            {
              "label": "Mechanical",
              "value": "ME"
            },
            {
              "label": "Civil",
              "value": "CE"
